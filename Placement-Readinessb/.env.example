# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/placement_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application URL (for CORS allowance)
FRONTEND_URL=https://your-app.netlify.app

# Resend Email Configuration (Production Single Provider)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Adithya Placement Cell <onboarding@resend.dev>
