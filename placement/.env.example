# GEMINI_API_KEY: Optional for Gemini AI chatbot in frontend
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this web application is hosted (e.g., Netlify domain)
APP_URL="https://your-app.netlify.app"

# VITE_API_URL: The URL of your deployed Render backend API
# Production on Netlify: https://placement-readiness-backend.onrender.com/api (or leave blank to use Netlify proxy redirect)
# Local development: http://localhost:5000/api
VITE_API_URL="https://placement-readiness-backend.onrender.com/api"
